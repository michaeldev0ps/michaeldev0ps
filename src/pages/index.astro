---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Michaeldevops | Backend & DevOps Engineer"
	description="MichaelDevOps portfolio for systems-first, Linux-native, automation-focused engineering."
>
	<main class="wrapper page stack gap-20">
		<section class="hero">
			<div class="stack gap-8">
				<h1 class="hero-title">MichaelDevOps</h1>
				<p class="labeled">
					<!-- Hero section -->
					Backend & DevOps Engineer focused on Linux systems, automation, and reliable deployments.
				</p>
				<p class="labeled">
					<!-- Text box under hero -->
					Systems-first, Linux-native, automation-focused. Calm, technical, and dependable delivery.
				</p>
			</div>
			<div class="hero-panel stack gap-8">
				<p class="labeled">
					<!-- Text box under hero -->
					Open to remote opportunities and client collaborations in backend engineering and DevOps.
				</p>
				<ul class="quick-list">
					<li>Location: Nigeria</li>
					<li>Email: michealdevops@gmail.com</li>
					<li>Focus: CI/CD, automation, Linux, and production workflows</li>
				</ul>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<h2>What I Build</h2>
				<p class="labeled">
					<!-- Text box under hero -->
					Backend services, deployment pipelines, and system tooling designed for reliability and clarity.
				</p>
			</div>
			<div class="card-grid three">
				<div class="card">
					<h3>Automation-first workflows</h3>
					<p class="labeled">
						<!-- Text box under hero -->
						Shell-native scripts, repeatable tasks, and infrastructure hygiene that reduce manual work.
					</p>
				</div>
				<div class="card">
					<h3>Deployment readiness</h3>
					<p class="labeled">
						<!-- Text box under hero -->
						CI/CD pipelines, artifact tracking, and release checks tuned for production safety.
					</p>
				</div>
				<div class="card">
					<h3>Systems thinking</h3>
					<p class="labeled">
						<!-- Text box under hero -->
						Linux-first approach with observability, incident readiness, and clear documentation.
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-header">
				<h2>Featured &amp; Live Projects</h2>
				<p class="labeled">
					<!-- Text box under hero -->
					Production-minded builds spanning product design, deployment, automation, and real-world reliability.
				</p>
			</div>
				<div class="card-grid">
					<div class="card">
						<span class="tag">Featured product</span>
						<h3>Child Lens</h3>
						<p class="labeled">Parent-focused behavior-support platform for ages 3–12, built with privacy, guided workflows, and responsible product design.</p>
						<a href="https://child-behavior-compass.vercel.app" target="_blank" rel="noreferrer">Open Child Lens ↗</a>
					</div>
				<div class="card">
					<span class="tag">Live project</span>
					<h3>Polling App</h3>
					<p class="labeled">
						<!-- Project card description -->
						Real-time polling system with backend workflow automation and production-focused setup.
					</p>
					<a href="https://polling-5rz6qbxru-michaels-projects-f46388ef.vercel.app">Live demo ↗</a>
				</div>
				<div class="card">
					<span class="tag">Live project</span>
					<h3>PAIXX</h3>
					<p class="labeled">Luxury streetwear platform exploring pain, purpose, and peace through editorial design.</p>
					<a href="https://deno-fresh-poc.vercel.app">Live site ↗</a>
				</div>
				<div class="card">
					<span class="tag">Live project</span>
					<h3>Real Estate Portfolio</h3>
					<p class="labeled">
						<!-- Project card description -->
						Deployment-ready portfolio with structured environments and clean build pipelines.
					</p>
					<a href="https://real-estate-pnsevn9y2-michaels-projects-f46388ef.vercel.app">Live site ↗</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>


