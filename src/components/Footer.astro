---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="footer-lead"><span>Available for thoughtful builds</span><a href="mailto:michealdevops@gmail.com">michealdevops@gmail.com ↗</a></div>
	<div class="footer-meta"><span>MichaelDevOps · Backend &amp; DevOps</span><span>&copy; {currentYear}</span><a href="https://github.com/michaeldev0ps">GitHub ↗</a></div>
</footer>
<style>
	footer {
		display: flex;
		display: grid;
		gap: 3rem;
		margin-top: auto;
		padding: 3rem 2rem 3.5rem;
		text-align: left;
		color: var(--gray-300);
		font-size: var(--text-sm);
		border-top: 1px solid rgba(148, 163, 184, 0.15);
	}
	.footer-lead { display: grid; gap: .75rem; }
	.footer-lead span { color: var(--accent-light); text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; }
	.footer-lead a { font-size: clamp(1.5rem, 4vw, 3rem); color: var(--gray-100); text-decoration: none; }
	.footer-meta { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; color: var(--gray-400); font-size: .85rem; }

	footer a {
		color: var(--gray-200);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	footer a:hover,
	footer a:focus {
		color: var(--accent-light);
	}

	@media (min-width: 50em) {
		footer {
			padding: 2.5rem 4.5rem 3rem;
		}
	}
</style>

